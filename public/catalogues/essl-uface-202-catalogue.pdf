            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Disclaimer: Brief specifications are mentioned here.Specificati</photoshop:LayerName>
                  <photoshop:LayerText>Disclaimer: Brief specifications are mentioned here.Specifications may change without prior notice. Customers are advised to check with us before purchase. Actual product may differ slightly to that depicted for ongoing product development  www.esslsecurity.com</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Fingerprint</photoshop:LayerName>
                  <photoshop:LayerText>Fingerprint</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Face</photoshop:LayerName>
                  <photoshop:LayerText>Face</photoshop:LayerText>
               </rdf:li>
