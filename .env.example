# ==============================================================================
# MEENAKSHI TECHNOLOGIES - DOCKER ENVIRONMENT CONFIGURATION
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# Node Environment & Server Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL Service)
DB_HOST=db
DB_PORT=5432
DB_NAME=meenakshi_cms
DB_USER=meenakshi_user
DB_PASSWORD=meenakshi_secure_password_2026
DATABASE_URL=postgres://meenakshi_user:meenakshi_secure_password_2026@db:5432/meenakshi_cms

# Redis Cache Service
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# CMS Authentication & Session Security
JWT_SECRET=meenakshi_jwt_secret_production_2026_super_secure
SESSION_SECRET=meenakshi_session_secret_encryption_key_2026

# Super Admin Initial Credentials (Seeded automatically)
SUPER_ADMIN_EMAIL=admin@meenakshi.com
SUPER_ADMIN_PASSWORD=Meenakshi@2026

# Company Contact Information
PRIMARY_PHONE=+916301593064
WHATSAPP_PHONE=916301593064
PRIMARY_EMAIL=meenakshitechnologies65@gmail.com
WEBSITE_URL=https://www.meenakshitechnologies.org

# SMTP Email Dispatch (Optional - for instant lead notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=meenakshitechnologies65@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
