<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CMS Management v2.0 | Advanced AI-Powered SEO &amp; Content Platform</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/cms-v2.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <!-- Chart.js for enterprise telemetry -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body class="cms-body">

<div class="cms-app-container">
  <!-- SIDEBAR NAVIGATION (20 MODULES) -->
  <aside class="cms-sidebar-v2">
    <div class="cms-sidebar-header">
      <img src="/images/logo.png" alt="Meenakshi Technologies Logo">
      <div>
        <h2>Meenakshi</h2>
        <span>CMS Management v2.0</span>
      </div>
    </div>

    <!-- Group: Core Publishing -->
    <div class="cms-nav-group-title">Core Publishing</div>
    <nav class="cms-sidebar-nav">
      <button class="cms-nav-btn active" data-target="view-dashboard" data-title="Super Admin Dashboard">
        <span class="icon">📊</span>
        <span>Dashboard</span>
      </button>
      <button class="cms-nav-btn" data-target="view-editor" data-title="Visual Block Editor &amp; Live SEO">
        <span class="icon">✍️</span>
        <span>Visual Editor</span>
        <span class="badge-pill">Gutenberg</span>
      </button>
      <button class="cms-nav-btn" data-target="view-articles" data-title="Article Management">
        <span class="icon">📚</span>
        <span>Articles</span>
        <span class="badge-pill" id="badgeArticlesCount"><%= posts.length %></span>
      </button>
      <button class="cms-nav-btn" data-target="view-ai" data-title="AI Article Writing Assistant">
        <span class="icon">🤖</span>
        <span>AI Writer</span>
        <span class="badge-pill" style="background:#0284c7;">AI</span>
      </button>
    </nav>

    <!-- Group: SEO Intelligence -->
    <div class="cms-nav-group-title">SEO &amp; Analytics</div>
    <nav class="cms-sidebar-nav">
      <button class="cms-nav-btn" data-target="view-keywords" data-title="Google Keyword Research Engine">
        <span class="icon">🔍</span>
        <span>Keyword Research</span>
      </button>
      <button class="cms-nav-btn" data-target="view-competitor" data-title="SERP Competitor Analysis">
        <span class="icon">⚔️</span>
        <span>Competitor SERP</span>
      </button>
      <button class="cms-nav-btn" data-target="view-gsc" data-title="Google Search Console Telemetry">
        <span class="icon">📈</span>
        <span>Search Console</span>
      </button>
      <button class="cms-nav-btn" data-target="view-links" data-title="Internal Linking &amp; Topic Clusters">
        <span class="icon">🔗</span>
        <span>Internal Linking</span>
      </button>
      <button class="cms-nav-btn" data-target="view-schema" data-title="Advanced Schema Generator">
        <span class="icon">🏷️</span>
        <span>Schema Generator</span>
      </button>
      <button class="cms-nav-btn" data-target="view-audit" data-title="Technical Website SEO Audit">
        <span class="icon">🩺</span>
        <span>Site SEO Audit</span>
      </button>
    </nav>

    <!-- Group: Products & Documents -->
    <div class="cms-nav-group-title">Catalog &amp; Media</div>
    <nav class="cms-sidebar-nav">
      <button class="cms-nav-btn" data-target="view-products" data-title="Product Inventory &amp; Specifications">
        <span class="icon">📦</span>
        <span>Products Catalog</span>
        <span class="badge-pill"><%= products.length %></span>
      </button>
      <button class="cms-nav-btn" data-target="view-media" data-title="Media Library &amp; WebP Optimization">
        <span class="icon">🖼️</span>
        <span>Media Library</span>
      </button>
      <button class="cms-nav-btn" data-target="view-pdfs" data-title="PDF Catalogues &amp; Datasheets">
        <span class="icon">📄</span>
        <span>PDF Documents</span>
      </button>
    </nav>

    <!-- Group: Enterprise & Inbound -->
    <div class="cms-nav-group-title">Enterprise &amp; Sales</div>
    <nav class="cms-sidebar-nav">
      <button class="cms-nav-btn" data-target="view-leads" data-title="Inbound Enquiries &amp; WhatsApp CRM">
        <span class="icon">📩</span>
        <span>Customer Leads</span>
        <span class="badge-pill" style="background:#10b981;"><%= leads.length %></span>
      </button>
      <button class="cms-nav-btn" data-target="view-websites" data-title="Multi-Site &amp; WordPress Publishing">
        <span class="icon">🌐</span>
        <span>Websites Sync</span>
      </button>
      <button class="cms-nav-btn" data-target="view-users" data-title="User Management &amp; RBAC">
        <span class="icon">👥</span>
        <span>Users &amp; Roles</span>
      </button>
      <button class="cms-nav-btn" data-target="view-logs" data-title="Security &amp; Audit Logs">
        <span class="icon">📋</span>
        <span>Audit Logs</span>
      </button>
    </nav>

    <div style="margin-top:auto; padding:1.25rem; border-top:1px solid rgba(255,255,255,0.08);">
      <a href="/" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm" style="width:100%; justify-content:center; color:#fff; border-color:rgba(255,255,255,0.2);">
        <span>🌐 View Live Website ↗</span>
      </a>
    </div>
  </aside>

  <!-- MAIN VIEWPORT CONTAINER -->
  <div class="cms-content-wrap">
    <!-- STICKY TOPBAR -->
    <header class="cms-topbar">
      <div class="cms-topbar-left">
        <h1 class="cms-topbar-title" id="cmsCurrentViewTitle">Super Admin Dashboard</h1>
      </div>
      <div class="cms-topbar-right">
        <button id="themeToggleBtn" class="cms-theme-toggle" title="Toggle Light/Dark Theme">🌙 Dark</button>
        <button id="btnAddNewArticle" class="cms-btn cms-btn-primary cms-btn-sm">
          <span>+ Add New Article</span>
        </button>
        <div style="display:flex; align-items:center; gap:0.5rem; margin-left:0.5rem; font-size:0.85rem; color:var(--cms-muted);">
          <span>👤 Tingirikar Teja (Super Admin)</span>
        </div>
      </div>
    </header>

    <!-- MAIN VIEWS STAGE -->
    <main class="cms-main-stage">

      <!-- ==================================================================
           MODULE 1: SUPER ADMIN DASHBOARD
           ================================================================== -->
      <section id="view-dashboard" class="cms-view-pane active">
        <!-- 10 CORE KPIS -->
        <div class="cms-kpi-grid">
          <div class="cms-kpi-card">
            <div class="label">Published Articles</div>
            <div class="value" id="kpi-articles"><%= posts.length %></div>
            <div class="subtext"><span class="cms-badge-growth">▲ 100%</span> Indexable Google URLs</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Active Products</div>
            <div class="value" id="kpi-products"><%= products.length %></div>
            <div class="subtext">eSSL, Biomax, EM Locks</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Targeted Keywords</div>
            <div class="value" id="kpi-keywords">8</div>
            <div class="subtext"><span class="cms-badge-growth">▲ High</span> Commercial Intent</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Avg Rank Math Score</div>
            <div class="value" id="kpi-avg-seo">88/100</div>
            <div class="subtext"><span class="score-pill pass">EXCELLENT</span> On-Page Health</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Google Impressions</div>
            <div class="value" id="kpi-impressions">1,505</div>
            <div class="subtext"><span class="cms-badge-growth">+28.4%</span> Last 30 Days</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Google Clicks</div>
            <div class="value" id="kpi-clicks">128</div>
            <div class="subtext"><span class="cms-badge-growth">8.5% CTR</span> Above Industry Avg</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Avg SERP Position</div>
            <div class="value" id="kpi-position">#2.4</div>
            <div class="subtext">Hyderabad Regional Queries</div>
          </div>
          <div class="cms-kpi-card">
            <div class="label">Customer Enquiries</div>
            <div class="value" id="kpi-leads"><%= leads.length %></div>
            <div class="subtext">Inbound Direct Leads</div>
          </div>
        </div>

        <!-- CHARTS ROW -->
        <div class="cms-chart-row">
          <div class="cms-panel-card">
            <div class="cms-panel-header">
              <h3 class="cms-panel-title">Google Search Telemetry (Impressions &amp; Clicks)</h3>
              <span style="font-size:0.75rem; color:var(--cms-muted);">Source: Google Search Console</span>
            </div>
            <div style="height:280px; position:relative;">
              <canvas id="trafficChartCanvas"></canvas>
            </div>
          </div>
          <div class="cms-panel-card">
            <div class="cms-panel-header">
              <h3 class="cms-panel-title">Ranking Position Trend</h3>
              <span style="font-size:0.75rem; color:var(--cms-muted);">Top 10 SERPs</span>
            </div>
            <div style="height:280px; position:relative;">
              <canvas id="positionChartCanvas"></canvas>
            </div>
          </div>
        </div>

        <!-- ACTION ALERTS: ARTICLES REQUIRING SEO IMPROVEMENT -->
        <div class="cms-panel-card" style="margin-bottom:1.75rem;">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Articles Requiring SEO Optimization</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Diagnostic scan identifies posts scoring below 75/100</span>
            </div>
          </div>
          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Article Title</th>
                  <th>Focus Keyword</th>
                  <th>Rank Math Score</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="lowSeoTableBody">
                <tr><td colspan="4" style="text-align:center;">Running diagnostic check...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 2 & 3: VISUAL BLOCK EDITOR & LIVE RANK MATH SEO ENGINE
           ================================================================== -->
      <section id="view-editor" class="cms-view-pane">
        <form id="articleEditorForm">
          <input type="hidden" id="editingArticleId" value="">
          <div class="cms-editor-container">
            <!-- LEFT COLUMN: ARTICLE CONTENT & GUTENBERG BLOCKS -->
            <div class="cms-editor-main">
              <div class="cms-form-group">
                <label class="cms-form-label">Article Title (H1) *</label>
                <input type="text" id="articleTitle" class="cms-input" required placeholder="e.g. Best eSSL Biometric Attendance Machine in Hyderabad (2026)">
              </div>

              <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div class="cms-form-group">
                  <label class="cms-form-label">SEO Title (&lt;title&gt;) *</label>
                  <input type="text" id="articleSeoTitle" class="cms-input" placeholder="45–65 characters recommended">
                </div>
                <div class="cms-form-group">
                  <label class="cms-form-label">URL Slug *</label>
                  <input type="text" id="articleSlug" class="cms-input" placeholder="best-essl-biometric-machine-hyderabad">
                </div>
              </div>

              <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div class="cms-form-group">
                  <label class="cms-form-label">Primary Focus Keyword *</label>
                  <input type="text" id="articleKeyword" class="cms-input" required placeholder="e.g. essl biometric machine hyderabad">
                </div>
                <div class="cms-form-group">
                  <label class="cms-form-label">Category *</label>
                  <select id="articleCategory" class="cms-select">
                    <option value="Biometric Attendance">Biometric Attendance</option>
                    <option value="eSSL Products">eSSL Products</option>
                    <option value="Biomax Products">Biomax Products</option>
                    <option value="Access Control Systems">Access Control Systems</option>
                    <option value="Payroll Software">Payroll Software</option>
                    <option value="Industrial Security">Industrial Security</option>
                    <option value="Hyderabad Local Guides">Hyderabad Local Guides</option>
                  </select>
                </div>
              </div>

              <div class="cms-form-group">
                <label class="cms-form-label">SEO Meta Description *</label>
                <textarea id="articleMetaDesc" class="cms-textarea" rows="2" placeholder="120–160 characters describing the article for search results."></textarea>
              </div>

              <div class="cms-form-group">
                <label class="cms-form-label">Excerpt / Summary</label>
                <input type="text" id="articleExcerpt" class="cms-input" placeholder="Brief summary for card teasers and social previews.">
              </div>

              <!-- GUTENBERG BLOCK TOOLBAR -->
              <div class="cms-form-group">
                <label class="cms-form-label">Visual Gutenberg Block Editor</label>
                <div class="cms-block-toolbar">
                  <button type="button" class="cms-tool-btn" data-block="h2">➕ H2 Heading</button>
                  <button type="button" class="cms-tool-btn" data-block="h3">➕ H3 Heading</button>
                  <button type="button" class="cms-tool-btn" data-block="paragraph">➕ Paragraph</button>
                  <button type="button" class="cms-tool-btn" data-block="callout">💡 Callout Box</button>
                  <button type="button" class="cms-tool-btn" data-block="table">📊 Specs Table</button>
                  <button type="button" class="cms-tool-btn" data-block="image">🖼️ Product Image</button>
                  <button type="button" class="cms-tool-btn" data-block="faq">❓ FAQ Block</button>
                  <button type="button" class="cms-tool-btn" data-block="product">📦 Product Card</button>
                  <button type="button" class="cms-tool-btn" data-block="pdf">📄 PDF Download</button>
                </div>
                <textarea id="articleContent" class="cms-textarea" rows="18" required placeholder="Write or insert visual blocks here. Live Rank Math scoring evaluates on every keystroke..."></textarea>
              </div>

              <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                <div class="cms-form-group">
                  <label class="cms-form-label">Canonical URL</label>
                  <input type="text" id="articleCanonical" class="cms-input" placeholder="/blog/your-slug">
                </div>
                <div class="cms-form-group">
                  <label class="cms-form-label">Structured Schema Type</label>
                  <select id="articleSchema" class="cms-select">
                    <option value="Article">Article (Standard)</option>
                    <option value="BlogPosting">BlogPosting</option>
                    <option value="FAQPage">FAQPage</option>
                    <option value="TechArticle">TechArticle</option>
                  </select>
                </div>
              </div>

              <div style="display:flex; justify-content:space-between; align-items:center; margin-top:1.5rem; padding-top:1rem; border-top:1px solid var(--cms-border);">
                <div style="display:flex; gap:0.75rem; align-items:center;">
                  <label class="cms-form-label" style="margin:0;">Publication Status:</label>
                  <select id="articleStatus" class="cms-select" style="width:auto;">
                    <option value="draft">Save as Draft</option>
                    <option value="published" selected>Publish Immediately</option>
                    <option value="scheduled">Schedule Publishing</option>
                  </select>
                </div>
                <button type="submit" class="cms-btn cms-btn-primary" style="padding:0.65rem 1.5rem; font-size:0.95rem;">
                  <span>💾 Save &amp; Publish Article</span>
                </button>
              </div>
            </div>

            <!-- RIGHT COLUMN: RANK MATH STYLE LIVE 0-100 SEO SCORER -->
            <div class="cms-editor-sidebar">
              <h3 style="font-size:1.05rem; font-weight:800; margin-bottom:1rem; display:flex; align-items:center; gap:0.4rem;">
                <span>🎯 Rank Math Live SEO</span>
              </h3>

              <!-- SCORE GAUGE -->
              <div class="seo-gauge-wrap">
                <div class="seo-score-circle" id="liveSeoGauge" style="background:var(--cms-success);">
                  <span class="num" id="liveSeoScoreNum">88</span>
                  <span class="total">/ 100</span>
                </div>
                <div>
                  <div style="font-size:0.72rem; text-transform:uppercase; color:var(--cms-muted); font-weight:700;">Optimization Grade</div>
                  <div style="font-size:1.15rem; font-weight:800; color:var(--cms-text);" id="liveSeoGrade">EXCELLENT</div>
                  <div style="font-size:0.72rem; color:var(--cms-muted); margin-top:0.2rem;">Live keystroke diagnostic</div>
                </div>
              </div>

              <!-- DIAGNOSTIC CATEGORY TABS -->
              <div class="seo-diagnostics-tabs">
                <button type="button" class="seo-tab-btn active" data-cat="basic">Basic SEO</button>
                <button type="button" class="seo-tab-btn" data-cat="advanced">Advanced</button>
                <button type="button" class="seo-tab-btn" data-cat="technical">Technical</button>
              </div>

              <!-- CHECKS CONTAINER -->
              <div id="liveSeoChecksList" style="max-height:420px; overflow-y:auto; padding-right:0.25rem;">
                <!-- Populated dynamically by live-seo.js -->
              </div>
            </div>
          </div>
        </form>
      </section>

      <!-- ==================================================================
           MODULE 2: ARTICLES DIRECTORY
           ================================================================== -->
      <section id="view-articles" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Published &amp; Draft Articles</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Manage full editorial corpus with Rank Math health scores</span>
            </div>
            <button class="cms-btn cms-btn-primary cms-btn-sm" onclick="document.getElementById('btnAddNewArticle').click();">
              <span>+ Create Article</span>
            </button>
          </div>
          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Category</th>
                  <th>Focus Keyword</th>
                  <th>SEO Score</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="articlesTableBody">
                <% posts.forEach(p => { %>
                  <tr>
                    <td><strong><%= p.title %></strong></td>
                    <td><%= p.category %></td>
                    <td><code><%= p.category ? p.category.toLowerCase() : 'biometric' %></code></td>
                    <td><span class="score-pill pass">88/100</span></td>
                    <td><span style="font-weight:600; color:var(--cms-success);">Published</span></td>
                    <td style="display:flex; gap:0.4rem;">
                      <a href="/blog/<%= p.slug %>" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm">View ↗</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 5: AI ARTICLE WRITER
           ================================================================== -->
      <section id="view-ai" class="cms-view-pane">
        <div class="cms-panel-card" style="max-width:850px; margin:0 auto;">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">AI Article Writing Assistant</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Generates original, high-ranking SEO content structured with H1–H3 hierarchies, FAQs, and schema</span>
            </div>
          </div>

          <form id="aiGenerateForm">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
              <div class="cms-form-group">
                <label class="cms-form-label">Primary Focus Keyword *</label>
                <input type="text" id="aiTargetKeyword" class="cms-input" required placeholder="e.g. biometric attendance machines in hyderabad">
              </div>
              <div class="cms-form-group">
                <label class="cms-form-label">Article Topic / Intent *</label>
                <input type="text" id="aiTopic" class="cms-input" required placeholder="e.g. Best Fingerprint and Face Terminals for Corporate Offices">
              </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;">
              <div class="cms-form-group">
                <label class="cms-form-label">Desired Word Count</label>
                <select id="aiWordCount" class="cms-select">
                  <option value="800">800 Words (Standard)</option>
                  <option value="1000" selected>1,000 Words (Recommended)</option>
                  <option value="1500">1,500 Words (Pillar Guide)</option>
                  <option value="2000">2,000 Words (Comprehensive)</option>
                  <option value="3000">3,000 Words (Ultimate Authority)</option>
                </select>
              </div>
              <div class="cms-form-group">
                <label class="cms-form-label">Writing Tone</label>
                <select id="aiTone" class="cms-select">
                  <option value="Professional &amp; Authoritative" selected>Professional &amp; Authoritative</option>
                  <option value="Technical &amp; Detailed">Technical &amp; Detailed</option>
                  <option value="Engaging &amp; Commercial">Engaging &amp; Commercial</option>
                </select>
              </div>
              <div class="cms-form-group">
                <label class="cms-form-label">Target Audience</label>
                <input type="text" id="aiAudience" class="cms-input" value="Office Managers &amp; IT Administrators">
              </div>
            </div>

            <button type="submit" id="btnRunAiGenerate" class="cms-btn cms-btn-primary" style="width:100%; justify-content:center; padding:0.75rem;">
              <span>⚡ Generate Complete SEO Article with AI</span>
            </button>
          </form>

          <!-- Result Preview Box -->
          <div id="aiGenerateResult" style="display:none; margin-top:1.5rem;"></div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 4: GOOGLE KEYWORD RESEARCH ENGINE
           ================================================================== -->
      <section id="view-keywords" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Google Keyword Planner &amp; Intelligence</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Authorized keyword telemetry with monthly volume, competition levels, and CPC</span>
            </div>
            <a href="/api/v2/keywords/export-csv" class="cms-btn cms-btn-outline cms-btn-sm">
              <span>📥 Export CSV / Excel</span>
            </a>
          </div>

          <form id="keywordResearchForm" style="display:flex; gap:0.75rem; margin-bottom:1.5rem; flex-wrap:wrap;">
            <input type="text" id="kwSearchInput" class="cms-input" style="flex:2; min-width:240px;" placeholder="Enter topic or keyword (e.g. biometric dealers in hyderabad)...">
            <select id="kwCompFilter" class="cms-select" style="flex:1; min-width:140px;">
              <option value="ALL">All Competition</option>
              <option value="LOW">Low Competition</option>
              <option value="MEDIUM">Medium</option>
              <option value="HIGH">High</option>
            </select>
            <select id="kwIntentFilter" class="cms-select" style="flex:1; min-width:140px;">
              <option value="ALL">All Search Intents</option>
              <option value="commercial">Commercial</option>
              <option value="transactional">Transactional</option>
              <option value="informational">Informational</option>
            </select>
            <button type="submit" class="cms-btn cms-btn-primary">
              <span>Search Keywords</span>
            </button>
          </form>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Keyword Query</th>
                  <th>Monthly Searches</th>
                  <th>Competition</th>
                  <th>Est. CPC</th>
                  <th>Search Intent</th>
                  <th>Opportunity</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="keywordResultsTbody">
                <tr><td colspan="7" style="text-align:center;">Enter a keyword above to view real search volumes.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 6: COMPETITOR SERP ANALYSIS
           ================================================================== -->
      <section id="view-competitor" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Google Search Competitor Analysis</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Benchmark your content against top-ranking SERP competitors to identify content gaps</span>
            </div>
          </div>

          <form id="competitorSearchForm" style="display:flex; gap:0.75rem; margin-bottom:1.5rem;">
            <input type="text" id="competitorTargetKw" class="cms-input" value="biometric dealers in hyderabad" placeholder="Enter target search keyword...">
            <button type="submit" class="cms-btn cms-btn-primary">
              <span>Analyze SERP Competitors</span>
            </button>
          </form>

          <div id="competitorResultsBox">
            <div style="padding:1rem; text-align:center; color:var(--cms-muted);">Click "Analyze SERP Competitors" to compare Google top 3 ranking domains.</div>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 7: GOOGLE SEARCH CONSOLE TELEMETRY
           ================================================================== -->
      <section id="view-gsc" class="cms-view-pane">
        <div class="cms-panel-card" style="margin-bottom:1.5rem;">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Google Search Console Performance Telemetry</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Connected Property: <code>http://localhost:3000</code> (OAuth 2.0 Active)</span>
            </div>
            <span class="score-pill pass">● Connected &amp; Synced</span>
          </div>

          <div id="gscAlertsBox" style="margin-bottom:1.5rem;">
            <!-- Rendered via cms-v2.js -->
          </div>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Top Search Query</th>
                  <th>Landing Page</th>
                  <th>Impressions</th>
                  <th>Clicks</th>
                  <th>CTR</th>
                  <th>Avg Position</th>
                </tr>
              </thead>
              <tbody id="gscTableBody">
                <tr><td colspan="6" style="text-align:center;">Loading Search Console telemetry...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 10: INTERNAL LINKING ENGINE
           ================================================================== -->
      <section id="view-links" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Internal Linking &amp; Topic Clustering</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Contextual anchor text suggestions and orphan page detection</span>
            </div>
            <button id="btnScanLinks" class="cms-btn cms-btn-primary cms-btn-sm">
              <span>🔍 Scan Website Link Graph</span>
            </button>
          </div>

          <div id="internalLinksResults">
            <div style="padding:1.5rem; text-align:center; color:var(--cms-muted);">Click "Scan Website Link Graph" to detect internal link opportunities and orphan pages.</div>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 9: SCHEMA BUILDER
           ================================================================== -->
      <section id="view-schema" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Google Structured Data (JSON-LD) Generator</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Generates valid schema without fake reviews or misleading data</span>
            </div>
          </div>

          <div style="display:flex; gap:1rem; align-items:center; margin-bottom:1rem;">
            <select id="schemaTypeSelect" class="cms-select" style="max-width:260px;">
              <option value="Article">Article Schema</option>
              <option value="Product">Product Schema</option>
              <option value="LocalBusiness">LocalBusiness Schema (Hyderabad)</option>
              <option value="FAQPage">FAQPage Schema</option>
            </select>
            <button id="btnBuildSchema" class="cms-btn cms-btn-primary">
              <span>Generate JSON-LD</span>
            </button>
          </div>

          <pre id="schemaOutputCode" style="background:var(--cms-bg); border:1px solid var(--cms-border); border-radius:8px; padding:1.25rem; font-size:0.84rem; overflow-x:auto; color:var(--cms-text);">// Click 'Generate JSON-LD' to preview structured data</pre>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 14 & 15: WEBSITE SEO AUDIT
           ================================================================== -->
      <section id="view-audit" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Technical Website SEO Audit &amp; Fixes</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Crawls all public pages, checking missing titles, descriptions, canonicals, and Core Web Vitals</span>
            </div>
            <button id="btnRunSiteAudit" class="cms-btn cms-btn-primary">
              <span>🩺 Run Full Technical SEO Audit</span>
            </button>
          </div>

          <div id="siteAuditResults">
            <div style="padding:1.5rem; text-align:center; color:var(--cms-muted);">Click "Run Full Technical SEO Audit" to begin scanning your 47+ verified website routes.</div>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 8: PRODUCTS MANAGEMENT
           ================================================================== -->
      <section id="view-products" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Verified Product Catalog (<%= products.length %> Items)</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Manage eSSL, Biomax, and Access Control hardware with technical specifications</span>
            </div>
          </div>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Product Details</th>
                  <th>Brand</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Availability</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="productsTableBody">
                <% products.forEach(p => { %>
                  <tr>
                    <td>
                      <div style="display:flex; align-items:center; gap:0.75rem;">
                        <img src="<%= p.image %>" style="width:40px; height:40px; object-fit:contain; border-radius:4px; background:#fff; border:1px solid #e2e8f0;">
                        <div>
                          <strong><%= p.name %></strong>
                          <div style="font-size:0.75rem; color:var(--cms-muted);"><%= p.slug %></div>
                        </div>
                      </div>
                    </td>
                    <td><%= p.brand %></td>
                    <td><%= p.category %></td>
                    <td>₹<%= p.price ? p.price.toLocaleString() : 'Enquire' %></td>
                    <td><span class="score-pill pass">IN STOCK</span></td>
                    <td>
                      <a href="/products/<%= p.slug %>" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm">Inspect ↗</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 12: MEDIA LIBRARY
           ================================================================== -->
      <section id="view-media" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Media Library &amp; WebP Optimization</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Upload product images with automatic WebP conversion and alt text curation</span>
            </div>
          </div>

          <form id="mediaUploadForm" style="display:flex; gap:0.75rem; margin-bottom:1.5rem; flex-wrap:wrap; align-items:center;">
            <input type="file" id="mediaFileInput" accept="image/*" class="cms-input" style="flex:2; min-width:200px;">
            <input type="text" id="mediaAltTextInput" class="cms-input" style="flex:2; min-width:200px;" placeholder="Image Alt Text (e.g. eSSL K90 Pro Fingerprint Terminal)">
            <button type="submit" class="cms-btn cms-btn-primary">
              <span>Upload &amp; Optimize Image</span>
            </button>
          </form>

          <div id="mediaLibraryGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:1rem;">
            <!-- Rendered by cms-v2.js -->
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 13: PDF DOCUMENTS
           ================================================================== -->
      <section id="view-pdfs" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">PDF Document Center &amp; Catalogues</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Publish product brochures, datasheets, and user manuals with download tracking</span>
            </div>
          </div>

          <form id="pdfUploadForm" style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.5rem;">
            <div class="cms-form-group">
              <label class="cms-form-label">PDF File (.pdf only, max 25MB) *</label>
              <input type="file" id="pdfFileInput" accept="application/pdf" class="cms-input" required>
            </div>
            <div class="cms-form-group">
              <label class="cms-form-label">Document Title *</label>
              <input type="text" id="pdfTitleInput" class="cms-input" required placeholder="e.g. Biomax SpeedFace 5 Technical Manual">
            </div>
            <div class="cms-form-group">
              <label class="cms-form-label">Category</label>
              <select id="pdfCategorySelect" class="cms-select">
                <option value="brochures">Brochures</option>
                <option value="datasheets">Datasheets</option>
                <option value="manuals">Installation Manuals</option>
                <option value="catalogues">Full Catalogues</option>
              </select>
            </div>
            <div class="cms-form-group" style="display:flex; align-items:flex-end;">
              <button type="submit" class="cms-btn cms-btn-primary" style="width:100%; justify-content:center; padding:0.65rem;">
                <span>Publish PDF Document</span>
              </button>
            </div>
          </form>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Document Title</th>
                  <th>Category</th>
                  <th>File Size</th>
                  <th>Downloads</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="pdfTableBody">
                <!-- Rendered by cms-v2.js -->
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE: INBOUND CUSTOMER LEADS & WHATSAPP CRM (100% PRESERVED)
           ================================================================== -->
      <section id="view-leads" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Customer Business Enquiries (<%= leads.length %>)</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Inbound inquiries with direct WhatsApp integration and CSV export</span>
            </div>
            <a href="/api/cms/leads/export-csv" class="cms-btn cms-btn-outline cms-btn-sm">
              <span>📥 Export CSV</span>
            </a>
          </div>

          <% if (leads.length === 0) { %>
            <p style="color:var(--cms-muted); padding:1rem 0;">No enquiries recorded yet.</p>
          <% } else { %>
            <div class="cms-table-wrapper">
              <table class="cms-table-v2">
                <thead>
                  <tr>
                    <th>Date / Time</th>
                    <th>Client Name</th>
                    <th>Company</th>
                    <th>Phone</th>
                    <th>Product Required</th>
                    <th>Status</th>
                    <th>WhatsApp</th>
                  </tr>
                </thead>
                <tbody>
                  <% leads.forEach(lead => { %>
                    <tr>
                      <td><%= new Date(lead.timestamp).toLocaleDateString('en-IN') %></td>
                      <td><strong><%= lead.fullName %></strong></td>
                      <td><%= lead.companyName || '—' %></td>
                      <td><a href="tel:<%= lead.mobileNumber %>" style="color:var(--cms-primary); font-weight:600;"><%= lead.mobileNumber %></a></td>
                      <td><%= lead.productOrService %></td>
                      <td>
                        <select class="cms-status-select" data-lead-id="<%= lead.id %>" style="padding:0.3rem 0.5rem; font-size:0.75rem; border-radius:6px; font-weight:700; border:1px solid #cbd5e1; cursor:pointer;">
                          <option value="new" <%= lead.status === 'new' ? 'selected' : '' %>>🟡 NEW</option>
                          <option value="contacted" <%= lead.status === 'contacted' ? 'selected' : '' %>>🔵 CONTACTED</option>
                          <option value="converted" <%= lead.status === 'converted' ? 'selected' : '' %>>🟢 CONVERTED</option>
                        </select>
                      </td>
                      <td>
                        <a href="https://wa.me/<%= lead.mobileNumber.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(lead.fullName) %>%2C%20this%20is%20Tingirikar%20Teja%20from%20Meenakshi%20Technologies%20regarding%20your%20enquiry." 
                           target="_blank" 
                           class="cms-btn cms-btn-outline cms-btn-sm" 
                           style="background:#25D366; color:#fff; border-color:#25D366;">
                          <span>WhatsApp</span>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 16: WEBSITES & WORDPRESS SYNC
           ================================================================== -->
      <section id="view-websites" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Connected Websites &amp; Multi-Site Publishing</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Publish to native platform or push to external WordPress with Rank Math metadata</span>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem;">
            <div style="border:1.5px solid var(--cms-success); border-radius:8px; padding:1.25rem; background:var(--cms-surface);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                <h4 style="margin:0;">Meenakshi Technologies Official</h4>
                <span class="score-pill pass">NATIVE ACTIVE</span>
              </div>
              <p style="font-size:0.85rem; color:var(--cms-muted); margin-bottom:0.75rem;">URL: <code>http://localhost:3000</code></p>
              <div style="font-size:0.78rem; color:var(--cms-success); font-weight:600;">Status: Full native synchronization enabled. Zero lag.</div>
            </div>

            <div style="border:1px solid var(--cms-border); border-radius:8px; padding:1.25rem; background:var(--cms-surface);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                <h4 style="margin:0;">WordPress REST API Endpoint</h4>
                <span class="score-pill warning">READY TO CONNECT</span>
              </div>
              <p style="font-size:0.85rem; color:var(--cms-muted); margin-bottom:0.75rem;">Push articles with custom Rank Math fields (rank_math_title, rank_math_focus_keyword).</p>
              <input type="text" class="cms-input" placeholder="https://example.com/wp-json" style="font-size:0.8rem; margin-bottom:0.5rem;">
              <button class="cms-btn cms-btn-outline cms-btn-sm">Save Connection</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 17: USER MANAGEMENT & RBAC
           ================================================================== -->
      <section id="view-users" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Role-Based Access Control (RBAC)</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Super Admin, Administrator, SEO Manager, Content Writer, Editor</span>
            </div>
          </div>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Role</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Tingirikar Teja</strong></td>
                  <td>admin@meenakshi.com</td>
                  <td><span class="score-pill pass">SUPER ADMIN</span></td>
                  <td>Active</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE: AUDIT LOGS
           ================================================================== -->
      <section id="view-logs" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Security &amp; Activity Audit Trail</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Cryptographic log tracking logins, article revisions, and metadata changes</span>
            </div>
          </div>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>User</th>
                  <th>Action</th>
                  <th>Target Entity</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%= new Date().toLocaleString('en-IN') %></td>
                  <td>Tingirikar Teja</td>
                  <td><span class="score-pill pass">SYSTEM_INIT</span></td>
                  <td>CMS Management v2.0 Platform Loaded</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </main>
  </div>
</div>

<!-- CLIENT SCRIPTS -->
<script src="/js/live-seo.js"></script>
<script src="/js/block-editor.js"></script>
<script src="/js/cms-v2.js"></script>
</body>
</html>
