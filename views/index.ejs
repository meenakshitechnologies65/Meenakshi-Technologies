            <span id="simAutoPlayText">Auto Simulation: Active</span>
          </button>
        </div>
      </div>

      <!-- Scenario Selector Buttons -->
      <div class="sim-controls-bar">
        <span class="sim-controls-label">Test Scenarios:</span>
        <button type="button" class="sim-scenario-btn active" data-scenario="authorized">
          <span class="sim-icon">🟢</span>
          <span>1. Scan Face / Finger (Access Granted)</span>
