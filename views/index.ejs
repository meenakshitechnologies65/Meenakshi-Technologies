          <span style="display:inline-block; padding:0.3rem 0.8rem; background:rgba(56, 189, 248, 0.15); color:#38bdf8; border:1px solid rgba(56, 189, 248, 0.35); border-radius:9999px; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.5rem;">
