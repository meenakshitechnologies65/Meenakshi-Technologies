    <!-- Right Contact Form -->
    <div class="contact-form-card">
      <h3 style="font-size:1.5rem; font-weight:800; color:#0b2545; margin-bottom:0.4rem;">Send a Business Enquiry</h3>
      <p style="font-size:0.9rem; color:#64748b; margin-bottom:1.5rem;">Fill out the details below and our team will get in touch with you promptly.</p>

      <form class="enquiry-form">
        <!-- Anti-Spam Honeypot Field -->
        <input type="text" name="website_source" class="honeypot-field" tabindex="-1" autocomplete="off">

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label">Full Name *</label>
            <input type="text" name="fullName" class="form-control" required placeholder="Your Full Name">
          </div>
          <div class="form-group">
            <label class="form-label">Company Name</label>
            <input type="text" name="companyName" class="form-control" placeholder="Company / Organization">
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label">Mobile Number *</label>
            <input type="tel" name="mobileNumber" class="form-control" required placeholder="+91 98765 43210">
          </div>
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input type="email" name="email" class="form-control" required placeholder="name@domain.com">
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label">City / Location in Hyderabad *</label>
            <input type="text" name="location" class="form-control" required placeholder="e.g. LB Nagar, Madhapur, Uppal">
          </div>
          <div class="form-group">
            <label class="form-label">Product / Service Required</label>
            <select name="productOrService" class="form-control">
              <option value="Biometric Attendance Machine">Biometric Attendance Machine</option>
              <option value="Face Recognition Attendance Terminal">Face Recognition Terminal</option>
              <option value="Door Access Control & EM Lock">Door Access Control &amp; EM Lock</option>
              <option value="eSSL Hardware Supply & Support">eSSL Hardware Supply &amp; Support</option>
              <option value="Biomax Hardware Supply">Biomax Hardware Supply</option>
              <option value="Payroll Software Integration">Payroll Software Integration</option>
              <option value="Gym Management Software">Gym Management Software</option>
              <option value="Installation / AMC Service">Installation / AMC Service</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Number of Employees</label>
          <select name="employeeCount" class="form-control">
            <option value="1-20 Employees">1 - 20 Employees</option>
            <option value="20-50 Employees">20 - 50 Employees</option>
            <option value="50-200 Employees">50 - 200 Employees</option>
            <option value="200-500 Employees">200 - 500 Employees</option>
            <option value="500+ Employees">500+ Employees</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Message / Specific Requirements</label>
          <textarea name="message" class="form-control" rows="3" placeholder="Please specify door types (glass, wooden), facility location, shift counts, etc."></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">
          <span>Submit Business Enquiry</span>
        </button>

        <div class="form-status-msg"></div>
      </form>
    </div>
