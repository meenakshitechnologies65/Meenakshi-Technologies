<%- include('partials/head', { 
  title: `${product.name} Biometric System Hyderabad | Meenakshi Technologies`,
  metaDescription: `Verified specs, genuine pricing quotation, and onsite installation details for ${product.name} by ${product.brand} from Meenakshi Technologies in Hyderabad.`,
  canonicalUrl: `https://www.meenakshitechnologies.org/products/${product.slug}`,
  ogImage: product.image
}) %>

<!-- Product Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "<%= product.name %>",
  "image": "https://www.meenakshitechnologies.org<%= product.image %>",
  "description": "<%= product.tagline %>",
  "brand": {
    "@type": "Brand",
    "name": "<%= product.brand %>"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Meenakshi Technologies"
    }
  }
}
</script>

<!-- Breadcrumb Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.meenakshitechnologies.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": "https://www.meenakshitechnologies.org/products"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "<%= product.name %>",
      "item": "https://www.meenakshitechnologies.org/products/<%= product.slug %>"
    }
  ]
}
</script>

<%- include('partials/header', { activePage: 'products' }) %>

<header class="pillar-page-header">
  <div class="container" style="max-width: 900px; margin: 0 auto;">
    <div style="font-size:0.85rem; color:#93c5fd; margin-bottom:0.5rem;">
      <a href="/products" style="color:#38bdf8;">Products</a> &rarr; <span><%= product.category %></span>
    </div>
    <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; text-transform: uppercase;">
      <%= product.brand %> Genuine Hardware
    </span>
    <h1 style="font-size: 2.6rem; font-weight: 900; color: #fff; margin: 0.8rem 0;">
      <%= product.name %>
    </h1>
    <p style="font-size: 1.15rem; color: #cbd5e1; line-height: 1.6;">
      <%= product.tagline %>
    </p>
  </div>
</header>

<div class="container" style="padding: 4rem 1.5rem;">
  <div style="display: grid; grid-template-columns: 1fr 1.25fr; gap: 3.5rem; align-items: flex-start;">
    <!-- Left: Image & Quick Contact -->
    <div>
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 2rem;">
        <img src="<%= product.image %>" alt="<%= product.name %> Biometric Machine Hyderabad" style="max-height: 320px; margin: 0 auto;">
      </div>

      <div style="background: #eef4f8; border-radius: 12px; padding: 1.8rem; border: 1px solid #cbd5e1;">
        <h4 style="font-size: 1.1rem; color: #0b2545; font-weight: 800; margin-bottom: 0.8rem;">Ready for Quotation &amp; Dispatch?</h4>
        <p style="font-size: 0.88rem; color: #475569; margin-bottom: 1.2rem;">We maintain ready stock in Hyderabad and provide professional installation across Telangana.</p>
        
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <button class="btn btn-primary open-quote-modal-btn" data-product-name="<%= product.name %>" style="width: 100%;">
            <span>Request Official Price Quote</span>
          </button>
          
          <% if (product.cataloguePdf) { %>
            <a href="<%= product.cataloguePdf %>" 
               download="<%= product.name %>-Datasheet-Meenakshi-Technologies.pdf" 
               class="btn btn-pdf-download" 
               style="padding: 0.75rem 1rem; font-size: 0.95rem; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <polyline points="9 15 12 18 15 15"></polyline>
              </svg>
              <span>Download Official PDF Datasheet</span>
            </a>
          <% } %>

          <a href="/catalogues/meenakshi-technologies-product-catalogue-2026.pdf" 
             download="Meenakshi-Technologies-Complete-Product-Catalogue-2026.pdf" 
             class="btn btn-outline" 
             style="width: 100%; border-color: #0b2545; color: #0b2545; background: #fff; font-size: 0.88rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <span>📄 Download Full 2026 Catalogue (All Models)</span>
          </a>

          <a href="https://wa.me/916301593064?text=Hello%20Meenakshi%20Technologies%2C%20I%20am%20interested%20in%20pricing%20and%20installation%20for%20<%= encodeURIComponent(product.name) %>." 
             target="_blank" 
             rel="noopener" 
             class="btn btn-whatsapp" 
             style="width: 100%;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>Instant WhatsApp Enquiry</span>
          </a>
          <button onclick="window.print()" class="btn btn-outline" style="width: 100%; border-color: #cbd5e1; color: #64748b; background: transparent; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.82rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            <span>Print Specification Sheet</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Right: Detailed Specs, Features, Applications -->
    <div>
      <!-- Key Features -->
      <div style="margin-bottom: 2.5rem;">
        <h3 style="font-size: 1.5rem; font-weight: 800; color: #0b2545; margin-bottom: 1rem;">Key Features &amp; Capabilities</h3>
        <ul style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% product.features.forEach(feat => { %>
            <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.98rem; color: #334155;">
              <span style="color: #0066cc; font-weight: bold;">&#10004;</span>
              <span><%= feat %></span>
            </li>
          <% }) %>
        </ul>
      </div>

      <!-- Technical Specifications Table -->
      <div style="margin-bottom: 2.5rem;">
        <h3 style="font-size: 1.5rem; font-weight: 800; color: #0b2545; margin-bottom: 1rem;">Verified Technical Specifications</h3>
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
          <table class="article-table">
            <tbody>
              <% for (const [k, v] of Object.entries(product.specs)) { %>
                <tr>
                  <td style="font-weight: 700; width: 40%; text-transform: capitalize; color: #0b2545;">
                    <%= k.replace(/([A-Z])/g, ' $1') %>
                  </td>
                  <td style="color: #475569;"><%= v %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Applications -->
      <div style="margin-bottom: 2.5rem;">
        <h3 style="font-size: 1.5rem; font-weight: 800; color: #0b2545; margin-bottom: 1rem;">Recommended Applications</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
          <% product.applications.forEach(app => { %>
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.85rem; font-size: 0.9rem; color: #334155;">
              <strong>&#9679;</strong> <%= app %>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Installation Info -->
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
        <h4 style="font-size: 1.1rem; font-weight: 800; color: #0b2545; margin-bottom: 0.5rem;">Installation &amp; Integration Information</h4>
        <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;"><%= product.installationInfo %></p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

