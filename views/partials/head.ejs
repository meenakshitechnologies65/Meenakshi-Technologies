          border-top: 1px solid rgba(245, 158, 11, 0.35) !important;
          border-bottom: 3.5px solid #f59e0b !important;
          max-height: 85vh !important;
          overflow-y: auto !important;
        }
        .nav-menu.active .nav-link,
        .site-header .nav-menu.active .nav-link {
          display: flex !important;
          align-items: center !important;
          justify-content: space-between !important;
          width: 100% !important;
          padding: 1rem 1.25rem !important;
          font-size: 1.05rem !important;
          font-weight: 700 !important;
          letter-spacing: 0.04em !important;
          text-transform: uppercase !important;
          color: #ffffff !important;
          background-color: #121826 !important;
          background: #121826 !important;
          border: 1px solid rgba(255, 255, 255, 0.14) !important;
          border-radius: 10px !important;
          margin-bottom: 0.65rem !important;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35) !important;
          text-decoration: none !important;
          transition: all 0.2s ease !important;
        }
        .brand-title {
          font-size: 1rem !important;
          line-height: 1.15 !important;
          color: #ffffff !important;
          font-weight: 800 !important;
        }
        .brand-subtitle {
          display: block !important;
          font-size: 0.62rem !important;
          color: #fbbf24 !important;
          font-weight: 700 !important;
          letter-spacing: 0.05em !important;
          text-transform: uppercase !important;
          line-height: 1.1 !important;
          margin-top: 1px !important;
        }
        .nav-menu.active .nav-link::after {
          content: '›' !important;
          position: static !important;
          display: inline-block !important;
          font-size: 1.6rem !important;
          line-height: 1 !important;
          color: #f59e0b !important;
          font-weight: 700 !important;
          margin-left: auto !important;
          width: auto !important;
          height: auto !important;
          background: none !important;
          bottom: auto !important;
          left: auto !important;
          transition: transform 0.2s ease, color 0.2s ease !important;
        }
        .nav-menu.active .nav-link:hover::after,
        .nav-menu.active .nav-link.active::after {
          color: #fbbf24 !important;
          transform: translateX(4px) !important;
        }
        .nav-menu.active .nav-link:hover,
        .nav-menu.active .nav-link:focus,
        .site-header .nav-menu.active .nav-link:hover {
          color: #fbbf24 !important;
          background-color: #1a233a !important;
          background: #1a233a !important;
          border-color: #f59e0b !important;
          padding-left: 1.45rem !important;
          box-shadow: 0 4px 14px rgba(245, 158, 11, 0.25) !important;
        }
        .nav-menu.active .nav-link.active,
        .site-header .nav-menu.active .nav-link.active {
          color: #fbbf24 !important;
          font-weight: 800 !important;
          background-color: #1a233a !important;
          background: #1a233a !important;
          border: 1.5px solid #f59e0b !important;
          border-left: 5px solid #f59e0b !important;
          padding-left: 1.45rem !important;
          box-shadow: 0 4px 16px rgba(245, 158, 11, 0.3) !important;
        }
      }
    </style>

