          height: 44px !important;
          min-width: 44px !important;
          min-height: 44px !important;
          padding: 0 !important;
          border-radius: 10px !important;
          background: #080c14 !important;
          background-color: #080c14 !important;
          border: 2px solid #f59e0b !important;
          box-shadow: 0 0 14px rgba(245, 158, 11, 0.45) !important;
          cursor: pointer !important;
          position: relative !important;
          z-index: 10001 !important;
        }
        .mobile-menu-btn:hover, .mobile-menu-btn:focus {
          background: #111726 !important;
          border-color: #fbbf24 !important;
          box-shadow: 0 0 18px rgba(251, 191, 36, 0.6) !important;
        }
        .mobile-menu-btn .icon-hamburger {
          display: block !important;
          width: 24px !important;
          height: 24px !important;
          stroke: #fbbf24 !important;
          filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.65)) !important;
        }
        .mobile-menu-btn .icon-close {
          display: none !important;
          width: 24px !important;
          height: 24px !important;
          stroke: #fbbf24 !important;
          filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.65)) !important;
        }
        .mobile-menu-btn[aria-expanded="true"] .icon-hamburger {
          display: none !important;
        }
        .mobile-menu-btn[aria-expanded="true"] .icon-close {
          display: block !important;
        }
        .mobile-menu-btn .hamburger-bar {
          display: none !important;
        }

        /* Mobile Drawer Container */
        .nav-menu {
          display: none !important;
        }
        .nav-menu.active {
          display: flex !important;
          flex-direction: column !important;
          align-items: stretch !important;
          position: absolute !important;
