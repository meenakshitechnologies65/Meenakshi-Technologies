<!-- ItemList Schema for Product Catalog -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Meenakshi Technologies Biometric & Access Control Catalog 2026",
  "description": "Verified manufacturer specifications for eSSL and BioMax biometric attendance machines, face recognition systems, and access control equipment in Hyderabad.",
  "numberOfItems": <%= products.length %>,
  "itemListElement": [
    <% products.forEach((prod, index) => { %>
      {
        "@type": "ListItem",
        "position": <%= index + 1 %>,
        "item": {
          "@type": "Product",
          "name": "<%= prod.name %>",
          "url": "https://www.meenakshitechnologies.org/products/<%= prod.slug %>",
          "image": "https://www.meenakshitechnologies.org<%= prod.image %>",
          "brand": {
            "@type": "Brand",
            "name": "<%= prod.brand %>"
          },
          "category": "<%= prod.category %>",
          "description": "<%= prod.shortDesc || prod.tagline %>"
        }
      }<%= index < products.length - 1 ? ',' : '' %>
    <% }) %>
  ]
}
</script>

<!-- Breadcrumb Schema -->
<script type="application/ld+json">
