<%- include('partials/head', { 
  title: 'Biometric Attendance Machines & Access Control Products | Meenakshi Technologies',
  metaDescription: 'Browse genuine eSSL and Biomax biometric attendance machines, fingerprint devices, face recognition terminals, RFID card readers and EM locks in Hyderabad.',
  canonicalUrl: 'https://www.meenakshitechnologies.org/products'
}) %>

<%- include('partials/header', { activePage: 'products' }) %>

<header class="pillar-page-header">
  <div class="container" style="text-align: center; max-width: 800px; margin: 0 auto;">
    <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; text-transform: uppercase;">
      Genuine Hardware Catalog
    </span>
    <h1 style="font-size: 2.8rem; font-weight: 900; color: #fff; margin: 1rem 0;">
      Biometric Devices &amp; Security Products
    </h1>
    <p style="font-size: 1.15rem; color: #cbd5e1; line-height: 1.6;">
      Verified manufacturer specifications for eSSL, Biomax, and access control equipment. Ready stock and fast dispatch across Hyderabad and Telangana.
    </p>
    <div style="margin-top: 1.6rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href="/catalogues/meenakshi-technologies-product-catalogue-2026.pdf" 
         download="Meenakshi-Technologies-Product-Catalogue-2026.pdf" 
         class="btn btn-primary" 
         style="box-shadow: 0 4px 18px rgba(0, 180, 216, 0.45); display: inline-flex; align-items: center; gap: 0.65rem; padding: 0.85rem 1.6rem; font-size: 1rem; font-weight: 800; border-radius: 9999px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <polyline points="9 15 12 18 15 15"></polyline>
        </svg>
        <span>Download Complete 2026 Product Catalogue (PDF)</span>
      </a>
    </div>
  </div>
</header>

<div class="container" style="padding: 3.5rem 1.5rem;">
  <!-- Live Search & Quick Filter Controls -->
  <div style="max-width: 620px; margin: 0 auto 2rem auto; position: relative;">
    <input type="text" id="productSearchInput" placeholder="🔍 Search biometric machines, models (e.g. K30, Face, EM Lock)..." 
           style="width: 100%; padding: 0.95rem 1.25rem 0.95rem 3rem; font-size: 1rem; border: 2px solid #cbd5e1; border-radius: 9999px; outline: none; background: #fff; transition: all 0.2s ease; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 1.1rem; top: 50%; transform: translateY(-50%); pointer-events: none;">
      <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <div id="productSearchCount" style="font-size: 0.85rem; color: #64748b; text-align: center; margin-top: 0.6rem; font-weight: 500;">
      Showing all <%= products.length %> verified models in stock
    </div>
  </div>

  <!-- Filter Controls -->
  <div class="product-filters">
    <button class="filter-btn active" data-category="all">All Hardware</button>
    <button class="filter-btn" data-category="eSSL">eSSL Brand</button>
    <button class="filter-btn" data-category="Biomax">Biomax Brand</button>
    <button class="filter-btn" data-category="Fingerprint Biometric Devices">Fingerprint Scanners</button>
    <button class="filter-btn" data-category="Face Recognition Machines">Face Recognition</button>
    <button class="filter-btn" data-category="Door Access Controllers">Access Controllers</button>
    <button class="filter-btn" data-category="Electromagnetic Locks">EM Locks &amp; Bolts</button>
  </div>

  <!-- Grid of Products -->
  <div class="products-grid">
    <% products.forEach(prod => { %>
      <div class="product-card" data-category="<%= prod.category %>" data-brand="<%= prod.brand %>">
        <div class="product-thumb">
          <span class="product-brand-tag"><%= prod.brand %></span>
          <img src="<%= prod.image %>" alt="<%= prod.name %> in Hyderabad" loading="lazy">
        </div>
        <div class="product-info">
          <span class="product-category-name"><%= prod.category %></span>
          <h2 class="product-name" style="font-size: 1.3rem;">
            <a href="/products/<%= prod.slug %>" style="color:inherit;"><%= prod.name %></a>
          </h2>
          <p class="product-tagline"><%= prod.tagline %></p>

          <div class="product-specs-list">
            <% if (prod.capacity) { %>
              <div class="spec-line">
                <span>Capacity:</span>
                <span><%= prod.capacity.fingerprints || prod.capacity.faces || prod.capacity.holdingForce %></span>
              </div>
              <div class="spec-line">
                <span>Transactions:</span>
                <span><%= prod.capacity.transactions || prod.capacity.voltage || 'Commercial Grade' %></span>
              </div>
            <% } %>
          </div>

          <div class="product-card-actions">
            <div class="actions-row">
              <a href="/products/<%= prod.slug %>" class="btn btn-outline btn-sm" style="color:#0b2545; border-color:#cbd5e1;">
                <span>Specs &rarr;</span>
              </a>
              <a href="https://wa.me/916301593064?text=Hello%20Meenakshi%20Technologies%2C%20please%20share%20quotation%20and%20availability%20for%20<%= encodeURIComponent(prod.name) %>." 
                 target="_blank" 
                 rel="noopener" 
                 class="btn btn-whatsapp btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                <span>WhatsApp</span>
              </a>
            </div>
            <% if (prod.cataloguePdf) { %>
              <a href="<%= prod.cataloguePdf %>" 
                 download="<%= prod.name %>-Datasheet-Meenakshi-Technologies.pdf" 
                 class="btn-pdf-download" 
                 title="Download official PDF datasheet for <%= prod.name %>">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="12" y1="18" x2="12" y2="12"></line>
                  <polyline points="9 15 12 18 15 15"></polyline>
                </svg>
                <span>Download PDF Datasheet</span>
              </a>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Master Catalogue Callout Banner -->
  <div class="catalogue-download-banner">
    <div class="catalogue-banner-text">
      <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">
        2026 Complete Reference Guide
      </span>
      <h3 style="margin-top: 0.6rem;">Download Meenakshi Technologies 2026 Master Product Catalogue</h3>
      <p>
        Get the all-inclusive multi-page PDF brochure featuring verified technical specifications, user capacities, biometric templates, lock wiring diagrams, and warranty terms for all eSSL and BioMax systems.
      </p>
    </div>
    <div class="catalogue-banner-actions">
      <a href="/catalogues/meenakshi-technologies-product-catalogue-2026.pdf" 
         download="Meenakshi-Technologies-Product-Catalogue-2026.pdf" 
         class="btn-catalogue-main">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <polyline points="9 15 12 18 15 15"></polyline>
        </svg>
        <span>Download Full Catalogue (PDF)</span>
      </a>
      <span style="font-size: 0.78rem; color: #94a3b8;">Format: PDF (7.7 MB) • Free Instant Download</span>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

