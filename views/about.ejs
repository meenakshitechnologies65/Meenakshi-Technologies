  <!-- ON-SITE VIDEO FOOTAGE & FIELD INSTALLATION PROOF -->
  <div style="border-top: 1px solid #e2e8f0; padding-top: 3.5rem; margin-top: 3.5rem;">
    <div class="section-header-center">
      <span class="section-tagline">On-Site Field Demos</span>
