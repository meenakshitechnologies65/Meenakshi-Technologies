<%- include('partials/head', { 
  title: `${hub.title} | Meenakshi Technologies`,
  metaDescription: `${hub.description}`,
  canonicalUrl: `https://meenakshitechnologies.in/locations/${hub.slug}`
}) %>

<!-- Localized Hub Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "<%= hub.title %>",
  "provider": {
    "@type": "Organization",
    "name": "Meenakshi Technologies",
    "url": "https://meenakshitechnologies.in/"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "<%= hub.targetLocalities %>, Hyderabad, Telangana, India"
  },
  "description": "<%= hub.description %>"
}
</script>

<%- include('partials/header', { activePage: 'locations' }) %>

<header class="pillar-page-header">
  <div class="container" style="max-width: 900px; margin: 0 auto;">
    <div style="font-size:0.85rem; color:#93c5fd; margin-bottom:0.5rem;">
      <a href="/locations" style="color:#38bdf8;">Locations</a> &rarr; <span><%= hub.title %></span>
    </div>
    <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; text-transform: uppercase;">
      <%= hub.type %>
    </span>
    <h1 style="font-size: 2.6rem; font-weight: 900; color: #fff; margin: 0.8rem 0;">
      <%= hub.title %>
    </h1>
    <p style="font-size: 1.15rem; color: #cbd5e1; line-height: 1.6;">
      <%= hub.description %>
    </p>
  </div>
</header>

<div class="container" style="padding: 4rem 1.5rem;">
  <div class="detail-page-layout">
    <div>
      <!-- Local Focus & Highlights -->
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem; margin-bottom: 2.5rem; box-shadow: 0 4px 6px rgba(0,0,0,0.04);">
        <h3 style="font-size: 1.35rem; font-weight: 800; color: #0b2545; margin-bottom: 0.6rem;">Regional Industry Focus</h3>
        <p style="font-size: 1rem; color: #334155; line-height: 1.7; margin-bottom: 1.2rem;">
          <strong>Target Sectors:</strong> <%= hub.focus %>
        </p>
        <p style="font-size: 0.95rem; color: #475569; line-height: 1.6;">
          <strong>Covered Localities:</strong> <%= hub.targetLocalities %>
        </p>
      </div>

      <!-- Recommended Hardware for this Zone -->
      <div style="margin-bottom: 2.5rem;">
        <h3 style="font-size: 1.4rem; font-weight: 800; color: #0b2545; margin-bottom: 1.2rem;">Recommended Hardware &amp; Security Deployments</h3>
        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
          <% hub.recommendedSolutions.forEach(sol => { %>
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.2rem; display: flex; align-items: center; gap: 1rem;">
              <span style="color: #0066cc; font-size: 1.2rem; font-weight: 900;">&#10004;</span>
              <span style="font-weight: 700; color: #0b2545; font-size: 1rem;"><%= sol %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Local Service Promise -->
      <div style="background: #eef4f8; border-left: 4px solid #0066cc; padding: 1.8rem; border-radius: 8px;">
        <h4 style="font-size: 1.15rem; color: #0b2545; font-weight: 800; margin-bottom: 0.5rem;">Same-Day Field Service &amp; Onsite Delivery</h4>
        <p style="font-size: 0.95rem; color: #334155; line-height: 1.7;">
          Engineers from Meenakshi Technologies are deployed directly from our central Hyderabad and Balapur offices, ensuring rapid physical delivery, onsite mounting, cabling, and prompt response times across <%= hub.targetLocalities %>.
        </p>
      </div>
    </div>

    <!-- Right Sidebar Enquiry Form -->
    <div class="contact-form-card" style="box-shadow: 0 10px 25px rgba(0,0,0,0.06);">
      <h3 style="font-size: 1.3rem; font-weight: 800; color: #0b2545; margin-bottom: 0.4rem;">Request <%= hub.title.split(' in ')[1] || 'Local' %> Quote</h3>
      <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 1.2rem;">Get customized pricing and schedule an on-site facility demo.</p>

      <form class="enquiry-form">
        <input type="text" name="website_source" class="honeypot-field" tabindex="-1" autocomplete="off">
        <input type="hidden" name="location" value="<%= hub.title %>">

        <div class="form-group">
          <label class="form-label">Full Name *</label>
          <input type="text" name="fullName" class="form-control" required placeholder="Your Name">
        </div>
        <div class="form-group">
          <label class="form-label">Mobile Number (WhatsApp) *</label>
          <input type="tel" name="mobileNumber" class="form-control" required placeholder="+91 98765 43210">
        </div>
        <div class="form-group">
          <label class="form-label">Company Name</label>
          <input type="text" name="companyName" class="form-control" placeholder="Company / Enterprise">
        </div>
        <div class="form-group">
          <label class="form-label">Product / Service Required</label>
          <select name="productOrService" class="form-control">
            <option value="Biometric Attendance Machine">Biometric Attendance Machine</option>
            <option value="Face Recognition Attendance Terminal">Face Recognition Terminal</option>
            <option value="Door Access Control & EM Lock">Door Access Control &amp; EM Lock</option>
            <option value="eSSL Hardware Supply">eSSL Hardware Supply</option>
            <option value="Biomax Hardware Supply">Biomax Hardware Supply</option>
            <option value="Payroll Software Integration">Payroll Software Integration</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">
          <span>Submit Request</span>
        </button>

        <a href="https://wa.me/916301593064?text=Hello%20Meenakshi%20Technologies%2C%20I%20am%20looking%20for%20biometric%20solutions%20in%20<%= encodeURIComponent(hub.title) %>." 
           target="_blank" 
           rel="noopener" 
           class="btn btn-whatsapp" 
           style="width: 100%; margin-top: 0.75rem;">
          <span>WhatsApp Local Team</span>
        </a>
        <div class="form-status-msg"></div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

