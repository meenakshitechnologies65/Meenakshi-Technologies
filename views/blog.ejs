<%- include('partials/head', { 
  title: 'Biometric Knowledge Base & Technology Blog | Meenakshi Technologies',
  metaDescription: 'Guides, product comparisons, installation tutorials, and local Hyderabad biometric buying advice by Tingirikar Teja and Meenakshi Technologies.',
  canonicalUrl: 'https://meenakshitechnologies.org/blog'
}) %>

<%- include('partials/header', { activePage: 'blog' }) %>

<header class="pillar-page-header">
  <div class="container" style="text-align: center; max-width: 850px; margin: 0 auto;">
    <span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; text-transform: uppercase;">
      Insights &amp; Engineering Guides
    </span>
    <h1 style="font-size: 2.8rem; font-weight: 900; color: #fff; margin: 1rem 0;">
      Biometric Security &amp; Attendance Blog
    </h1>
    <p style="font-size: 1.15rem; color: #cbd5e1; line-height: 1.6;">
      Authoritative buying advice, technical tutorials, and product breakdowns authored by biometric specialists in Hyderabad.
    </p>
  </div>
</header>

<div class="container" style="padding: 4rem 1.5rem;">
  <!-- Blog Categories Bar -->
  <div class="product-filters" style="margin-bottom: 3rem;">
    <button class="filter-btn active">All Articles</button>
    <button class="filter-btn">Hyderabad Local Guides</button>
    <button class="filter-btn">Product Comparisons</button>
    <button class="filter-btn">Payroll Software</button>
    <button class="filter-btn">Access Control Systems</button>
    <button class="filter-btn">eSSL Products</button>
    <button class="filter-btn">Biomax Products</button>
  </div>

  <!-- Articles Grid -->
  <div class="blog-cards-grid">
    <% posts.forEach(post => { %>
      <article style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 6px rgba(0,0,0,0.03); transition: all 0.25s ease;">
        <div style="background: #0b2545; min-height: 180px; display: flex; align-items: center; justify-content: center; position: relative;">
          <% if (post.featuredImage) { %>
            <img src="<%= post.featuredImage %>" alt="<%= post.title %>" style="width: 100%; height: auto; object-fit: cover;">
          <% } %>
          <span style="position: absolute; top: 1rem; left: 1rem; background: rgba(3, 25, 38, 0.85); color: #38bdf8; font-size: 0.72rem; font-weight: 800; padding: 0.25rem 0.65rem; border-radius: 4px; text-transform: uppercase;">
            <%= post.category %>
          </span>
        </div>

        <div style="padding: 1.8rem; display: flex; flex-direction: column; flex-grow: 1;">
          <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 0.5rem; display: flex; gap: 0.75rem;">
            <span><%= post.date %></span>
            <span>&bull;</span>
            <span><%= post.readTime %></span>
          </div>

          <h2 style="font-size: 1.25rem; font-weight: 800; color: #0b2545; line-height: 1.35; margin-bottom: 0.75rem;">
            <a href="/blog/<%= post.slug %>" style="color: inherit;"><%= post.title %></a>
          </h2>

          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">
            <%= post.summary %>
          </p>

          <div style="border-top: 1px solid #e2e8f0; padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; margin-top: auto;">
            <span style="font-size: 0.82rem; font-weight: 600; color: #0b2545;">By <%= post.author %></span>
            <a href="/blog/<%= post.slug %>" style="color: #0066cc; font-size: 0.88rem; font-weight: 700;">
              Read Article &rarr;
            </a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>

