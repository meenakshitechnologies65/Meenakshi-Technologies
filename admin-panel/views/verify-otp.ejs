<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Two-Factor Verification (2FA) | Meenakshi Technologies</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-base: #06090e;
      --bg-surface: #0c121c;
      --bg-card: #121a28;
      --border-subtle: rgba(226, 232, 240, 0.12);
      --border-focus: rgba(245, 158, 11, 0.6);
      --text-white: #ffffff;
      --text-silver: #e2e8f0;
      --text-muted: #94a3b8;
      --gold-primary: #f59e0b;
      --gold-light: #fbbf24;
      --gold-dark: #d97706;
      --gold-glow: rgba(245, 158, 11, 0.25);
      --accent-emerald: #10b981;
      --accent-ruby: #ef4444;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 18px;
      --radius-xl: 24px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at top center, #131d2e 0%, #06090e 70%);
      color: var(--text-silver);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(226, 232, 240, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(226, 232, 240, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
    }

    .otp-container {
      width: 100%;
      max-width: 480px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 2.5rem 2.25rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 40px -10px var(--gold-glow);
      position: relative;
      z-index: 10;
      backdrop-filter: blur(16px);
      text-align: center;
      animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .shield-icon-wrapper {
      width: 64px;
      height: 64px;
      margin: 0 auto 1.5rem;
      border-radius: 50%;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold-light);
    }

    .shield-icon-wrapper svg {
      width: 32px;
      height: 32px;
    }

    .otp-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-white);
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }

    .otp-desc {
      font-size: 0.875rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 0.75rem;
    }

    .target-email {
      display: inline-block;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.25);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.825rem;
      color: var(--gold-light);
      margin-bottom: 1.75rem;
    }

    /* 6-box OTP digits */
    .otp-inputs {
      display: flex;
      gap: 0.6rem;
      justify-content: center;
      margin-bottom: 1.75rem;
    }

    .otp-digit {
      width: 52px;
      height: 60px;
      font-size: 1.75rem;
      font-weight: 700;
      text-align: center;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-white);
      background: var(--bg-card);
      border: 1.5px solid var(--border-subtle);
      border-radius: var(--radius-md);
      transition: all 0.2s ease;
      outline: none;
    }

    .otp-digit:focus {
      border-color: var(--gold-primary);
      box-shadow: 0 0 0 3px var(--gold-glow);
      background: #172235;
      transform: translateY(-2px);
    }

    .timer-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.825rem;
      color: var(--text-muted);
      margin-bottom: 1.75rem;
      padding: 0.5rem 0.25rem;
    }

    .countdown-timer {
      font-family: 'JetBrains Mono', monospace;
      color: var(--gold-light);
      font-weight: 700;
    }

    .btn-verify {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-dark) 100%);
      color: #000000;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.95rem 1.25rem;
      border-radius: var(--radius-md);
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
      margin-bottom: 1.25rem;
    }

    .btn-verify:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(245, 158, 11, 0.5);
    }

    .btn-verify:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .resend-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.75rem;
    }

    .btn-resend {
      background: none;
      border: none;
      color: var(--gold-primary);
      font-weight: 600;
      cursor: pointer;
      text-decoration: underline;
      padding: 0;
      font: inherit;
    }

    .btn-resend:disabled {
      color: var(--text-muted);
      cursor: not-allowed;
      text-decoration: none;
    }

    .alert {
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
      text-align: left;
      line-height: 1.4;
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .alert-success {
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #6ee7b7;
    }

    .back-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.825rem;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: var(--text-white);
    }

    .spinner {
      display: none;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(0, 0, 0, 0.3);
      border-top-color: #000000;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <div class="otp-container">
    <div class="shield-icon-wrapper">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
    </div>

    <h1 class="otp-title">Enter 2FA Code</h1>
    <p class="otp-desc">A 6-digit security verification code has been dispatched to your authorized administrator email.</p>
    
    <div class="target-email"><%= email %></div>

    <div id="feedbackBox" style="display:none;"></div>

    <form id="otpVerifyForm">
      <div class="otp-inputs" id="otpGroup">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit" data-idx="0" autofocus>
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit" data-idx="1">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit" data-idx="2">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit" data-idx="3">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit" data-idx="4">
        <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp-digit" data-idx="5">
      </div>

      <div class="timer-bar">
        <span>Expires in:</span>
        <span class="countdown-timer" id="expiryTimer">10:00</span>
      </div>

      <button type="submit" class="btn-verify" id="btnVerify">
        <span class="spinner" id="verifySpinner"></span>
        <span id="verifyText">Verify & Enter Dashboard</span>
      </button>

      <div class="resend-row">
        <span>Didn't receive the code?</span>
        <button type="button" class="btn-resend" id="btnResend" disabled>Resend Code (<span id="resendTimer">60</span>s)</button>
      </div>

      <a href="/admin/login" class="back-link">&larr; Switch Account or Return to Login</a>
    </form>
  </div>

  <script>
    const digits = Array.from(document.querySelectorAll('.otp-digit'));
    const form = document.getElementById('otpVerifyForm');
    const feedbackBox = document.getElementById('feedbackBox');
    const btnVerify = document.getElementById('btnVerify');
    const verifySpinner = document.getElementById('verifySpinner');
    const verifyText = document.getElementById('verifyText');
    const btnResend = document.getElementById('btnResend');
    const resendTimerEl = document.getElementById('resendTimer');
    const expiryTimerEl = document.getElementById('expiryTimer');

    // Auto focus first
    digits[0].focus();

    // Input navigation & paste handling
    digits.forEach((digit, idx) => {
      digit.addEventListener('input', (e) => {
        const val = e.target.value.replace(/[^0-9]/g, '');
        digit.value = val ? val[0] : '';
        if (val && idx < digits.length - 1) {
          digits[idx + 1].focus();
        }
        checkAutoSubmit();
      });

      digit.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !digit.value && idx > 0) {
          digits[idx - 1].focus();
        }
      });

      digit.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
        if (pasted.length >= 6) {
          digits.forEach((d, i) => {
            d.value = pasted[i] || '';
          });
          digits[5].focus();
          checkAutoSubmit();
        }
      });
    });

    function getCombinedOtp() {
      return digits.map(d => d.value).join('');
    }

    function checkAutoSubmit() {
      const code = getCombinedOtp();
      if (code.length === 6) {
        form.requestSubmit();
      }
    }

    // Submission handler
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const otp = getCombinedOtp();
      if (otp.length !== 6) {
        showFeedback('Please enter all 6 digits of your verification code.', 'error');
        return;
      }

      btnVerify.disabled = true;
      verifySpinner.style.display = 'inline-block';
      verifyText.textContent = 'Verifying Authenticity...';
      feedbackBox.style.display = 'none';

      try {
        const response = await fetch('/admin/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ otp })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          showFeedback('Verification successful! Access granted.', 'success');
          setTimeout(() => {
            window.location.href = data.redirectUrl || '/admin';
          }, 600);
        } else {
          showFeedback(data.error || 'Invalid verification code. Please check your email.', 'error');
          btnVerify.disabled = false;
          verifySpinner.style.display = 'none';
          verifyText.textContent = 'Verify & Enter Dashboard';
          digits.forEach(d => d.value = '');
          digits[0].focus();
        }
      } catch (err) {
        showFeedback('Connection error. Please try again.', 'error');
        btnVerify.disabled = false;
        verifySpinner.style.display = 'none';
        verifyText.textContent = 'Verify & Enter Dashboard';
      }
    });

    function showFeedback(msg, type) {
      feedbackBox.className = 'alert ' + (type === 'success' ? 'alert-success' : 'alert-error');
      feedbackBox.textContent = msg;
      feedbackBox.style.display = 'block';
    }

    // 10-Minute Expiry Timer
    let totalSecondsLeft = 10 * 60;
    const expiryInterval = setInterval(() => {
      totalSecondsLeft--;
      if (totalSecondsLeft <= 0) {
        clearInterval(expiryInterval);
        expiryTimerEl.textContent = 'EXPIRED';
        showFeedback('OTP has expired. Please request a new code.', 'error');
        btnVerify.disabled = true;
        return;
      }
      const mins = Math.floor(totalSecondsLeft / 60);
      const secs = totalSecondsLeft % 60;
      expiryTimerEl.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }, 1000);

    // 60-Second Resend Cooldown
    let resendCooldown = 60;
    const resendInterval = setInterval(() => {
      resendCooldown--;
      if (resendCooldown <= 0) {
        clearInterval(resendInterval);
        btnResend.disabled = false;
        btnResend.textContent = 'Resend Code Now';
      } else {
        resendTimerEl.textContent = resendCooldown;
      }
    }, 1000);

    btnResend.addEventListener('click', async () => {
      btnResend.disabled = true;
      btnResend.textContent = 'Sending...';

      try {
        const response = await fetch('/admin/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (response.ok && data.success) {
          showFeedback('A fresh 6-digit code has been emailed to you.', 'success');
          // Reset cooldown
          resendCooldown = 60;
          btnResend.innerHTML = 'Resend Code (<span id="resendTimer">60</span>s)';
          const newEl = document.getElementById('resendTimer');
          const newInterval = setInterval(() => {
            resendCooldown--;
            if (resendCooldown <= 0) {
              clearInterval(newInterval);
              btnResend.disabled = false;
              btnResend.textContent = 'Resend Code Now';
            } else {
              if (newEl) newEl.textContent = resendCooldown;
            }
          }, 1000);
        } else {
          showFeedback(data.error || 'Failed to resend code. Please wait.', 'error');
          btnResend.disabled = false;
          btnResend.textContent = 'Resend Code Now';
        }
      } catch (err) {
        showFeedback('Network error during resend.', 'error');
        btnResend.disabled = false;
        btnResend.textContent = 'Resend Code Now';
      }
    });
  </script>
</body>
</html>

