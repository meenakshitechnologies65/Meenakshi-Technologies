<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enterprise Admin Dashboard | Meenakshi Technologies</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/cms-v2.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --cms-gold: #f59e0b;
      --cms-gold-light: #fbbf24;
      --cms-gold-dark: #d97706;
      --cms-charcoal-dark: #06090e;
      --cms-charcoal-surface: #0c121c;
      --cms-charcoal-card: #121a28;
      --cms-silver-border: rgba(226, 232, 240, 0.12);
    }
    
    .admin-auth-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.78rem;
      color: var(--cms-gold-light);
      font-family: 'JetBrains Mono', monospace;
    }

    .btn-logout {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-logout:hover {
      background: #ef4444;
      color: #ffffff;
      border-color: #ef4444;
    }

    .badge-gold {
      background: linear-gradient(135deg, var(--cms-gold) 0%, var(--cms-gold-dark) 100%);
      color: #000;
      font-weight: 800;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      font-size: 0.72rem;
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
      margin-top: 1rem;
    }

    .video-card {
      background: var(--cms-surface);
      border: 1px solid var(--cms-border);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .video-thumb {
      position: relative;
      padding-top: 56.25%;
      background: #000;
    }

    .video-thumb iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .video-info {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .video-info h4 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--cms-text);
    }
  </style>
</head>
<body class="cms-body" data-theme="dark">

<div class="cms-app-container">
  <!-- SIDEBAR NAVIGATION -->
  <aside class="cms-sidebar-v2" style="background: #070a10; border-right: 1px solid rgba(245, 158, 11, 0.2);">
    <div class="cms-sidebar-header" style="border-bottom: 1px solid rgba(245, 158, 11, 0.25);">
      <img src="/images/logo.png" alt="Meenakshi Technologies Logo" style="background: #fff; padding: 3px; border-radius: 8px;">
      <div>
        <h2 style="color: #fff; font-size: 1rem; font-weight: 800;">Meenakshi</h2>
        <span style="color: var(--cms-gold-light); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">SECURE ADMIN</span>
      </div>
    </div>

    <!-- Group: Core Management -->
    <div class="cms-nav-group-title" style="color: rgba(226, 232, 240, 0.6);">Core Management</div>
    <nav class="cms-sidebar-nav">
      <button class="cms-nav-btn active" data-target="view-dashboard" data-title="System Overview">
        <span class="icon">📊</span>
        <span>Dashboard</span>
      </button>
      <button class="cms-nav-btn" data-target="view-products" data-title="Product Inventory &amp; Specifications">
        <span class="icon">📦</span>
        <span>Products Catalog</span>
        <span class="badge-gold"><%= products.length %></span>
      </button>
      <button class="cms-nav-btn" data-target="view-leads" data-title="Customer Enquiries &amp; WhatsApp CRM">
        <span class="icon">📩</span>
        <span>Enquiries / Leads</span>
        <span class="badge-pill" style="background:#10b981;"><%= leads.length %></span>
      </button>
      <button class="cms-nav-btn" data-target="view-videos" data-title="YouTube Videos &amp; Banners">
        <span class="icon">🎬</span>
        <span>YouTube &amp; Banners</span>
        <span class="badge-pill" style="background:#ef4444;"><%= videos.length %></span>
      </button>
      <button class="cms-nav-btn" data-target="view-articles" data-title="SEO Articles &amp; Blog">
        <span class="icon">📚</span>
        <span>SEO Articles</span>
        <span class="badge-pill"><%= posts.length %></span>
      </button>
    </nav>

    <!-- Group: Technical SEO & Security -->
    <div class="cms-nav-group-title" style="color: rgba(226, 232, 240, 0.6);">SEO &amp; Security</div>
    <nav class="cms-sidebar-nav">
      <button class="cms-nav-btn" data-target="view-seo-pages" data-title="Technical SEO &amp; Page Metadata">
        <span class="icon">🔍</span>
        <span>Page SEO Meta</span>
      </button>
      <button class="cms-nav-btn" data-target="view-audit-logs" data-title="Security &amp; Audit Logs">
        <span class="icon">🛡️</span>
        <span>Security Audit Logs</span>
        <span class="badge-pill" style="background:#8b5cf6;"><%= auditLogs.length %></span>
      </button>
    </nav>

    <div style="margin-top:auto; padding:1.25rem; border-top:1px solid rgba(255,255,255,0.08); display:flex; flex-direction:column; gap:0.6rem;">
      <a href="/" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm" style="width:100%; justify-content:center; color:#fff; border-color:rgba(255,255,255,0.2);">
        <span>🌐 View Live Website ↗</span>
      </a>
      <a href="/admin/logout" class="btn-logout" style="width:100%; justify-content:center;">
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span>End Session &amp; Logout</span>
      </a>
    </div>
  </aside>

  <!-- MAIN VIEWPORT CONTAINER -->
  <div class="cms-content-wrap">
    <!-- STICKY TOPBAR -->
    <header class="cms-topbar" style="background: rgba(12, 18, 28, 0.95); border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
      <div class="cms-topbar-left">
        <h1 class="cms-topbar-title" id="cmsCurrentViewTitle" style="color: #ffffff;">System Overview</h1>
      </div>
      <div class="cms-topbar-right" style="gap: 1rem;">
        <div class="admin-auth-pill">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          <span><%= adminUser ? adminUser.email : 'meenakshitechnologies65@gmail.com' %></span>
        </div>
        <a href="/admin/logout" class="btn-logout">
          <span>Logout</span>
        </a>
      </div>
    </header>

    <!-- MAIN VIEWS STAGE -->
    <main class="cms-main-stage">

      <!-- ==================================================================
           MODULE 1: SYSTEM OVERVIEW & KPIS
           ================================================================== -->
      <section id="view-dashboard" class="cms-view-pane active">
        <div class="cms-kpi-grid">
          <div class="cms-kpi-card" style="border-top: 3px solid var(--cms-gold);">
            <div class="label">Total Products</div>
            <div class="value" id="kpi-products"><%= products.length %></div>
            <div class="subtext">eSSL, BioMax &amp; Access Control</div>
          </div>
          <div class="cms-kpi-card" style="border-top: 3px solid #10b981;">
            <div class="label">Customer Enquiries</div>
            <div class="value" id="kpi-leads"><%= leads.length %></div>
            <div class="subtext"><span class="cms-badge-growth">Active CRM</span> Direct Inbound</div>
          </div>
          <div class="cms-kpi-card" style="border-top: 3px solid #38bdf8;">
            <div class="label">SEO Indexed Articles</div>
            <div class="value" id="kpi-articles"><%= posts.length %></div>
            <div class="subtext"><span class="score-pill pass">100% HEALTH</span> Google XML Sitemap</div>
          </div>
          <div class="cms-kpi-card" style="border-top: 3px solid #ef4444;">
            <div class="label">YouTube Showcase</div>
            <div class="value" id="kpi-videos"><%= videos.length %></div>
            <div class="subtext">Installation Proof Videos</div>
          </div>
        </div>

        <!-- RECENT ENQUIRIES QUICK VIEW -->
        <div class="cms-panel-card" style="margin-top:1.5rem;">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Recent Inbound Enquiries (Last 5)</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Live customer requests from contact forms and product pages</span>
            </div>
            <button class="cms-btn cms-btn-outline cms-btn-sm" onclick="switchToTab('view-leads')">View All Enquiries &rarr;</button>
          </div>
          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Customer Name</th>
                  <th>Mobile Number</th>
                  <th>Requirement</th>
                  <th>Location</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% leads.slice(0, 5).forEach(l => { %>
                  <tr>
                    <td><%= new Date(l.timestamp).toLocaleString('en-IN') %></td>
                    <td><strong><%= l.fullName %></strong><br><small style="color:var(--cms-muted);"><%= l.companyName || 'Individual' %></small></td>
                    <td>
                      <a href="tel:<%= l.mobileNumber %>" style="color:var(--cms-primary); font-weight:700;"><%= l.mobileNumber %></a>
                    </td>
                    <td><%= l.productOrService %></td>
                    <td><%= l.location %></td>
                    <td>
                      <span class="score-pill <%= l.status === 'new' ? 'warn' : 'pass' %>"><%= (l.status || 'NEW').toUpperCase() %></span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 2: PRODUCTS CATALOG MANAGER
           ================================================================== -->
      <section id="view-products" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Product Catalog Inventory</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Add, edit, or configure biometric hardware specifications and datasheets</span>
            </div>
            <button class="cms-btn cms-btn-primary cms-btn-sm" id="btnToggleNewProduct" style="background: linear-gradient(135deg, var(--cms-gold), var(--cms-gold-dark)); color: #000; font-weight: 700;">+ Add New Hardware</button>
          </div>

          <!-- Add Product Form (Collapsed) -->
          <div id="newProductBox" style="display:none; background: var(--cms-card); border: 1px solid var(--cms-gold); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem;">
            <h4 style="margin-bottom: 1rem; color: var(--cms-gold-light);">Add New Verified Biometric Machine</h4>
            <form id="createProductForm">
              <div style="display:grid; grid-template-columns: 2fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                  <label class="cms-form-label">Product Name *</label>
                  <input type="text" name="name" class="cms-input" required placeholder="e.g. eSSL MB20 Face & Fingerprint Machine">
                </div>
                <div>
                  <label class="cms-form-label">Brand *</label>
                  <select name="brand" class="cms-select" required>
                    <option value="eSSL">eSSL Security</option>
                    <option value="BioMax">BioMax Security</option>
                    <option value="Realtime">Realtime Biometrics</option>
                    <option value="ZKTeco">ZKTeco</option>
                    <option value="Meenakshi Technologies">Meenakshi Technologies</option>
                  </select>
                </div>
                <div>
                  <label class="cms-form-label">Model Code *</label>
                  <input type="text" name="model" class="cms-input" required placeholder="MB20">
                </div>
              </div>

              <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                  <label class="cms-form-label">Category *</label>
                  <select name="category" class="cms-select" required>
                    <option value="Biometric Fingerprint Attendance Machines">Biometric Fingerprint Attendance Machines</option>
                    <option value="Face Recognition Attendance Machines">Face Recognition Attendance Machines</option>
                    <option value="Advanced Multi-Biometric Devices">Advanced Multi-Biometric Devices</option>
                    <option value="Advanced Access Control Systems">Advanced Access Control Systems</option>
                    <option value="Biometric Access Control Readers">Biometric Access Control Readers</option>
                    <option value="Door Locking Systems">Door Locking Systems</option>
                    <option value="Turnstile and Entrance Management">Turnstile and Entrance Management</option>
                  </select>
                </div>
                <div>
                  <label class="cms-form-label">Image URL / Path</label>
                  <input type="text" name="image" class="cms-input" value="/images/products/essl-k90-pro.png">
                </div>
              </div>

              <div class="cms-form-group" style="margin-bottom: 1rem;">
                <label class="cms-form-label">Tagline / Short Description *</label>
                <textarea name="tagline" class="cms-textarea" rows="2" required placeholder="High-speed optical fingerprint and face terminal with TCP/IP and battery backup."></textarea>
              </div>

              <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                <button type="button" class="cms-btn cms-btn-outline" onclick="document.getElementById('newProductBox').style.display='none'">Cancel</button>
                <button type="submit" class="cms-btn cms-btn-primary" style="background: linear-gradient(135deg, var(--cms-gold), var(--cms-gold-dark)); color:#000; font-weight:700;">Save Hardware to Catalog</button>
              </div>
            </form>
          </div>

          <!-- Product Table -->
          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Product Details</th>
                  <th>Brand</th>
                  <th>Category</th>
                  <th>Capacity</th>
                  <th>PDF Datasheet</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach(p => { %>
                  <tr>
                    <td>
                      <div style="display:flex; align-items:center; gap:0.75rem;">
                        <img src="<%= p.image %>" style="width:42px; height:42px; object-fit:contain; border-radius:6px; background:#fff; padding:2px;" onerror="this.src='/images/products/essl-k90-pro.png';">
                        <div>
                          <strong><%= p.name %></strong><br>
                          <small style="color:var(--cms-muted);"><%= p.model %></small>
                        </div>
                      </div>
                    </td>
                    <td><span class="score-pill pass"><%= p.brand %></span></td>
                    <td><%= p.category %></td>
                    <td><small><%= p.capacity ? (p.capacity.fingerprints || p.capacity.faces || 'Standard') : 'Standard' %></small></td>
                    <td>
                      <a href="/api/v2/products/<%= p.slug %>/datasheet.pdf" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm" style="font-size:0.75rem;">
                        <span>📥 PDF</span>
                      </a>
                    </td>
                    <td>
                      <div style="display:flex; gap:0.4rem;">
                        <a href="/products/<%= p.slug %>" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm" title="View on website">👁️</a>
                        <button class="cms-btn cms-btn-outline cms-btn-sm" style="color:#ef4444;" onclick="deleteProductItem('<%= p.slug %>')">🗑️</button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 3: CUSTOMER ENQUIRIES CRM
           ================================================================== -->
      <section id="view-leads" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Customer Enquiries &amp; Leads CRM</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Track customer quote requests, click-to-call, and quick WhatsApp replies</span>
            </div>
            <a href="/api/cms/leads/export-csv" class="cms-btn cms-btn-outline cms-btn-sm">
              <span>📥 Export CSV</span>
            </a>
          </div>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Date &amp; Time</th>
                  <th>Customer / Company</th>
                  <th>Contact Info</th>
                  <th>Requirement</th>
                  <th>Location</th>
                  <th>Status</th>
                  <th>Quick Actions</th>
                </tr>
              </thead>
              <tbody>
                <% leads.forEach(l => { %>
                  <tr>
                    <td><small><%= new Date(l.timestamp).toLocaleString('en-IN') %></small></td>
                    <td>
                      <strong><%= l.fullName %></strong><br>
                      <small style="color:var(--cms-muted);"><%= l.companyName || 'Individual' %></small>
                    </td>
                    <td>
                      <a href="tel:<%= l.mobileNumber %>" style="color:var(--cms-primary); font-weight:700;"><%= l.mobileNumber %></a><br>
                      <small style="color:var(--cms-muted);"><%= l.email || 'No email' %></small>
                    </td>
                    <td>
                      <strong><%= l.productOrService %></strong><br>
                      <small style="color:var(--cms-muted);"><%= l.employeeCount || '' %></small>
                    </td>
                    <td><%= l.location %></td>
                    <td>
                      <select class="cms-select" style="font-size:0.75rem; padding:0.25rem 0.5rem;" onchange="updateLeadStatus('<%= l.id %>', this.value)">
                        <option value="new" <%= l.status === 'new' ? 'selected' : '' %>>New</option>
                        <option value="contacted" <%= l.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
                        <option value="quoted" <%= l.status === 'quoted' ? 'selected' : '' %>>Quoted</option>
                        <option value="closed" <%= l.status === 'closed' ? 'selected' : '' %>>Closed</option>
                      </select>
                    </td>
                    <td>
                      <div style="display:flex; gap:0.4rem;">
                        <% 
                          const cleanPhone = (l.mobileNumber || '').replace(/[^0-9]/g, '');
                          const waText = encodeURIComponent(`Hello ${l.fullName}, thank you for contacting Meenakshi Technologies regarding ${l.productOrService}. How can we assist you with installation?`);
                        %>
                        <a href="https://wa.me/91<%= cleanPhone.slice(-10) %>?text=<%= waText %>" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm" style="color:#25d366; border-color:rgba(37,211,102,0.4);" title="Reply on WhatsApp">
                          💬 WA
                        </a>
                        <a href="tel:<%= l.mobileNumber %>" class="cms-btn cms-btn-outline cms-btn-sm" title="Call directly">
                          📞 Call
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 4: YOUTUBE INSTALLATION VIDEOS & BANNERS
           ================================================================== -->
      <section id="view-videos" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">YouTube Installation Videos</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Verified site installation videos embedded on the homepage and landing pages</span>
            </div>
            <button class="cms-btn cms-btn-primary cms-btn-sm" onclick="document.getElementById('addVideoBox').style.display='block'" style="background: linear-gradient(135deg, var(--cms-gold), var(--cms-gold-dark)); color: #000; font-weight: 700;">+ Add Video</button>
          </div>

          <!-- Add Video Form -->
          <div id="addVideoBox" style="display:none; background: var(--cms-card); border: 1px solid var(--cms-gold); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem;">
            <h4 style="margin-bottom: 1rem; color: var(--cms-gold-light);">Embed New Installation Video</h4>
            <form id="newVideoForm">
              <div style="display:grid; grid-template-columns: 1fr 2fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                  <label class="cms-form-label">YouTube Video ID / URL *</label>
                  <input type="text" name="id" class="cms-input" required placeholder="e.g. CCfuLwMVFxE">
                </div>
                <div>
                  <label class="cms-form-label">Video Title / Client Installation *</label>
                  <input type="text" name="title" class="cms-input" required placeholder="e.g. eSSL K90 Biometric Installation at Bachupally">
                </div>
              </div>
              <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                  <label class="cms-form-label">Category</label>
                  <input type="text" name="category" class="cms-input" placeholder="Hospital / IT Park / Gym">
                </div>
                <div>
                  <label class="cms-form-label">Location</label>
                  <input type="text" name="location" class="cms-input" placeholder="Madhapur, Hyderabad">
                </div>
              </div>
              <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                <button type="button" class="cms-btn cms-btn-outline" onclick="document.getElementById('addVideoBox').style.display='none'">Cancel</button>
                <button type="submit" class="cms-btn cms-btn-primary" style="background: linear-gradient(135deg, var(--cms-gold), var(--cms-gold-dark)); color:#000; font-weight:700;">Save Video</button>
              </div>
            </form>
          </div>

          <div class="video-grid">
            <% videos.forEach(v => { %>
              <div class="video-card">
                <div class="video-thumb">
                  <iframe src="<%= v.embedUrl %>" loading="lazy" allowfullscreen></iframe>
                </div>
                <div class="video-info">
                  <h4><%= v.title %></h4>
                  <p style="font-size:0.78rem; color:var(--cms-muted); margin-bottom:0.75rem;">📍 <%= v.location %> | 🏷️ <%= v.category %></p>
                  <div style="margin-top:auto; display:flex; justify-content:space-between; align-items:center;">
                    <a href="<%= v.youtubeUrl %>" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm" style="font-size:0.75rem;">Watch on YouTube ↗</a>
                    <button class="cms-btn cms-btn-outline cms-btn-sm" style="color:#ef4444; font-size:0.75rem;" onclick="deleteVideoItem('<%= v.id %>')">Delete</button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 5: SEO ARTICLES
           ================================================================== -->
      <section id="view-articles" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Published SEO Articles &amp; Pillar Guides</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Google search-optimized technical guides and commercial buying articles</span>
            </div>
          </div>
          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Article Title</th>
                  <th>Category</th>
                  <th>Author</th>
                  <th>Reading Time</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% posts.forEach(p => { %>
                  <tr>
                    <td>
                      <strong><%= p.title %></strong><br>
                      <small style="color:var(--cms-muted); font-family:'JetBrains Mono',monospace;">/blog/<%= p.slug %></small>
                    </td>
                    <td><span class="score-pill pass"><%= p.category %></span></td>
                    <td><%= p.author %></td>
                    <td><%= p.readTime || '5 min' %></td>
                    <td>
                      <a href="/blog/<%= p.slug %>" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm">View Article ↗</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 6: TECHNICAL SEO & PAGE METADATA
           ================================================================== -->
      <section id="view-seo-pages" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Technical SEO &amp; Google Index Status</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Core website URL indexation, canonical domains, and XML sitemaps</span>
            </div>
            <a href="/sitemap.xml" target="_blank" class="cms-btn cms-btn-outline cms-btn-sm">View XML Sitemap ↗</a>
          </div>

          <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background:var(--cms-card); padding:1rem; border-radius:8px; border:1px solid var(--cms-border);">
              <div style="font-size:0.8rem; color:var(--cms-muted);">Canonical Domain</div>
              <div style="font-weight:700; color:var(--cms-gold-light); font-family:'JetBrains Mono',monospace;">https://meenakshitechnologies.org</div>
            </div>
            <div style="background:var(--cms-card); padding:1rem; border-radius:8px; border:1px solid var(--cms-border);">
              <div style="font-size:0.8rem; color:var(--cms-muted);">Robots.txt Directive</div>
              <div style="font-weight:700; color:#10b981;">Allow: / (Optimized)</div>
            </div>
            <div style="background:var(--cms-card); padding:1rem; border-radius:8px; border:1px solid var(--cms-border);">
              <div style="font-size:0.8rem; color:var(--cms-muted);">Structured Schema</div>
              <div style="font-weight:700; color:#38bdf8;">Organization + LocalBusiness + Product</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================================
           MODULE 7: SECURITY AUDIT TRAIL
           ================================================================== -->
      <section id="view-audit-logs" class="cms-view-pane">
        <div class="cms-panel-card">
          <div class="cms-panel-header">
            <div>
              <h3 class="cms-panel-title">Security &amp; Authentication Audit Log</h3>
              <span style="font-size:0.8rem; color:var(--cms-muted);">Live cryptographic audit trail stored in SQLite for logins, OTP verification, and access controls</span>
            </div>
            <button class="cms-btn cms-btn-outline cms-btn-sm" onclick="refreshAuditLogs()">🔄 Refresh Logs</button>
          </div>

          <div class="cms-table-wrapper">
            <table class="cms-table-v2">
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Email Account</th>
                  <th>Event Action</th>
                  <th>Status</th>
                  <th>IP Address</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody id="auditLogsBody">
                <% auditLogs.forEach(log => { %>
                  <tr>
                    <td><small><%= new Date(log.created_at).toLocaleString('en-IN') %></small></td>
                    <td><code style="font-size:0.8rem;"><%= log.email %></code></td>
                    <td><strong><%= log.action %></strong></td>
                    <td>
                      <span class="score-pill <%= log.status === 'SUCCESS' ? 'pass' : (log.status === 'BLOCKED' ? 'fail' : 'warn') %>">
                        <%= log.status %>
                      </span>
                    </td>
                    <td><small><%= log.ip_address || '127.0.0.1' %></small></td>
                    <td><small style="color:var(--cms-muted);"><%= log.details || '-' %></small></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </main>
  </div>
</div>

<script>
  // Tab switching
  const navButtons = document.querySelectorAll('.cms-sidebar-nav .cms-nav-btn');
  const viewPanes = document.querySelectorAll('.cms-view-pane');
  const viewTitle = document.getElementById('cmsCurrentViewTitle');

  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      const title = btn.getAttribute('data-title');
      switchToTab(targetId, title);
    });
  });

  function switchToTab(targetId, title) {
    navButtons.forEach(b => b.classList.toggle('active', b.getAttribute('data-target') === targetId));
    viewPanes.forEach(pane => pane.classList.toggle('active', pane.id === targetId));
    if (title && viewTitle) {
      viewTitle.textContent = title;
    }
  }

  // Toggle Add Product
  const btnToggleProduct = document.getElementById('btnToggleNewProduct');
  if (btnToggleProduct) {
    btnToggleProduct.addEventListener('click', () => {
      const box = document.getElementById('newProductBox');
      box.style.display = box.style.display === 'none' ? 'block' : 'none';
    });
  }

  // Submit Add Product
  const createProductForm = document.getElementById('createProductForm');
  if (createProductForm) {
    createProductForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createProductForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/admin/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('Product added successfully!');
          window.location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to add product'));
        }
      } catch (err) {
        alert('Network error adding product.');
      }
    });
  }

  // Delete Product
  async function deleteProductItem(slug) {
    if (!confirm('Are you sure you want to delete product ' + slug + '?')) return;
    try {
      const res = await fetch('/admin/api/products/' + slug, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        alert('Product deleted.');
        window.location.reload();
      } else {
        alert('Error: ' + data.error);
      }
    } catch (err) {
      alert('Network error deleting product.');
    }
  }

  // Update Lead Status
  async function updateLeadStatus(id, status) {
    try {
      const res = await fetch('/admin/api/leads/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (data.success) {
        console.log('Lead updated:', id, status);
      } else {
        alert('Failed to update lead status.');
      }
    } catch (err) {
      alert('Error updating lead.');
    }
  }

  // Add Video
  const newVideoForm = document.getElementById('newVideoForm');
  if (newVideoForm) {
    newVideoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(newVideoForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/admin/api/videos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('Video added successfully!');
          window.location.reload();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (err) {
        alert('Network error adding video.');
      }
    });
  }

  // Delete Video
  async function deleteVideoItem(id) {
    if (!confirm('Delete video ' + id + '?')) return;
    try {
      const res = await fetch('/admin/api/videos/' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        alert('Video removed.');
        window.location.reload();
      } else {
        alert('Error: ' + data.error);
      }
    } catch (err) {
      alert('Network error deleting video.');
    }
  }

  // Refresh Audit Logs
  async function refreshAuditLogs() {
    try {
      const res = await fetch('/admin/api/audit-logs');
      const data = await res.json();
      if (data.success) {
        const tbody = document.getElementById('auditLogsBody');
        tbody.innerHTML = data.logs.map(log => `
          <tr>
            <td><small>${new Date(log.created_at).toLocaleString('en-IN')}</small></td>
            <td><code style="font-size:0.8rem;">${log.email}</code></td>
            <td><strong>${log.action}</strong></td>
            <td>
              <span class="score-pill ${log.status === 'SUCCESS' ? 'pass' : (log.status === 'BLOCKED' ? 'fail' : 'warn')}">
                ${log.status}
              </span>
            </td>
            <td><small>${log.ip_address || '127.0.0.1'}</small></td>
            <td><small style="color:var(--cms-muted);">${log.details || '-'}</small></td>
          </tr>
        `).join('');
      }
    } catch (err) {
      alert('Failed to refresh audit logs.');
    }
  }
</script>
</body>
</html>

